# Rodando local: copie pra .env e preencha. No Coolify, as mesmas variáveis vão na tela do serviço.
# Sem YOUTUBE_CHAVE o YouTube mostra só o @; sem GITHUB_TOKEN os repos vêm da lista copiada no código.

# Endereços públicos (no Coolify, os domínios de cada serviço)
SITE_URL=http://localhost:8080
API_URL_PUBLICA=http://localhost:8082
KEYCLOAK_URL_PUBLICA=http://localhost:8180
# Origens liberadas no CORS da API (padrão: SITE_URL). Local: o site do Docker (:8080) e o "npm run dev" (:4321).
# No Coolify: https://henriquebueno.com,https://www.henriquebueno.com
ORIGENS=http://localhost:8080,http://localhost:4321
# Portas na sua máquina (só no docker-compose.local.yml)
PORTA_SITE=8080
PORTA_API=8082
PORTA_KEYCLOAK=8180

# MinIO (capas) e Keycloak (login do painel): invente senhas longas
MINIO_USUARIO=portfolio
MINIO_SENHA=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_SENHA=

YOUTUBE_CHAVE=
YOUTUBE_CANAL=@bueno_dev
GITHUB_TOKEN=

# E-mail do formulário (Hostinger: smtp.hostinger.com, porta 465, usuário = o próprio e-mail)
MAIL_MOCK=true
MAIL_HOST=smtp.hostinger.com
MAIL_PORTA=465
MAIL_USUARIO=contato@henriquebueno.com
MAIL_SENHA=
CONTATO_PARA=contato@henriquebueno.com
CONTATO_DE=contato@henriquebueno.com
