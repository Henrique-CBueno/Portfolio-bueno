---
// Painel: cadastrar vídeos (capa vai pro MinIO pela API) e atualizar os números sem API.
// Tudo acontece no navegador, depois do login no Keycloak; a página em si não tem dado nenhum.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/global.css';
---
<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="color-scheme" content="dark" />
		<title>Painel · bueno_dev</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body>
		<header class="topo">
			<a class="marca" href="/"><span class="tag">&lt;</span><span class="nome">Henrique Bueno</span><span class="tag">/&gt;</span></a>
			<div class="quem"><span class="pill amarelo">painel</span><span data-usuario></span><button class="botao" type="button" data-sair hidden>sair</button></div>
		</header>

		<main class="painel-admin">
			<p class="aviso" data-aviso>entrando…</p>

			<div data-conteudo hidden>
				<section class="bloco">
					<div class="cab-bloco"><h2 data-titulo-form>Novo <em>vídeo</em></h2><button class="botao" type="button" data-cancelar hidden>cancelar edição</button></div>
					<form class="painel form-video" data-form novalidate>
						<label class="capa-campo" data-capa-campo>
							<input type="file" name="capa" accept="image/jpeg,image/png,image/webp" data-capa-input />
							<img alt="" data-capa-previa hidden />
							<span data-capa-texto>capa 9:16<br /><small>JPEG, PNG ou WebP · até 5 MB</small></span>
						</label>
						<div class="campos">
							<div class="campo"><label for="titulo">título</label><input id="titulo" name="titulo" maxlength="120" required placeholder="1 API lenta derrubou tudo" /><small data-erro="titulo"></small></div>
							<div class="linha">
								<div class="campo"><label for="categoria">categoria</label><select id="categoria" name="categoria" data-categorias><option value="">sem categoria</option></select><small data-erro="categoria"></small></div>
								<div class="campo"><label for="publicadoEm">publicado em</label><input id="publicadoEm" name="publicadoEm" type="date" required /><small data-erro="publicadoEm"></small></div>
							</div>
							<div class="campo"><label for="instagram">link no instagram</label><input id="instagram" name="instagram" type="url" placeholder="https://www.instagram.com/reel/…" /><small data-erro="instagram"></small></div>
							<div class="campo"><label for="tiktok">link no tiktok</label><input id="tiktok" name="tiktok" type="url" placeholder="https://www.tiktok.com/@bueno_dev0/video/…" /><small data-erro="tiktok"></small></div>
							<div class="campo"><label for="youtube">link no youtube</label><input id="youtube" name="youtube" type="url" placeholder="https://youtube.com/shorts/…" /><small data-erro="youtube"></small></div>
							<small class="erro-geral" data-erro="links"></small>
							<small class="erro-geral" data-erro="capa"></small>
							<div class="enviar"><small data-estado-form>o card leva pro instagram; sem ele, pro tiktok; sem os dois, pro youtube</small><button class="botao primario" type="submit" data-enviar>publicar</button></div>
						</div>
					</form>
				</section>

				<section class="bloco">
					<div class="cab-bloco"><h2>Vídeos <em data-total></em></h2><small class="dica">o site se atualiza sozinho uns segundos depois de cada mudança</small></div>
					<div class="lista" data-lista></div>
				</section>

				<section class="bloco">
					<div class="cab-bloco"><h2>Números</h2><small class="dica">Instagram e TikTok não têm API ligada: digite aqui. Vazio = mostrar só o @.</small></div>
					<div class="numeros" data-numeros></div>
				</section>
			</div>
		</main>

		<script>
			import '../../scripts/painel';
		</script>

		<style>
			.topo { max-width: var(--largura); margin: 0 auto; padding: 18px var(--margem); display: flex; justify-content: space-between; align-items: center; gap: 16px; }
			.marca { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
			.marca .nome { font: 800 17px var(--sans); letter-spacing: -.02em; text-transform: uppercase; }
			.marca .tag { font: 700 17px var(--mono); color: var(--amarelo); }
			.quem { display: flex; align-items: center; gap: 12px; font: 500 13px var(--mono); color: var(--apagado); }
			.quem .botao { padding: 8px 14px; font-size: 12px; }
			.painel-admin { max-width: var(--largura); margin: 0 auto; padding: 16px var(--margem) 96px; }
			.aviso { font: 500 14px var(--mono); color: var(--apagado); padding: 40px 0; }
			.bloco + .bloco { margin-top: 56px; }
			.cab-bloco { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
			.cab-bloco h2 { font-size: 28px; }
			.cab-bloco h2 em { font-style: normal; color: var(--amarelo); }
			.dica { font: 500 12px var(--mono); color: var(--apagado); }

			.form-video { padding: 24px; display: grid; grid-template-columns: 220px 1fr; gap: 28px; }
			.capa-campo { position: relative; aspect-ratio: 9 / 16; border: 1.5px dashed var(--borda); border-radius: 14px; display: grid; place-items: center; text-align: center; cursor: pointer; overflow: hidden; background: var(--fundo); font: 700 13px var(--mono); color: var(--apagado); transition: border-color .2s; }
			.capa-campo:hover, .capa-campo:focus-within { border-color: var(--amarelo); }
			.capa-campo small { font-weight: 500; font-size: 11px; }
			.capa-campo input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
			.capa-campo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
			.campos { display: grid; gap: 14px; align-content: start; }
			.linha { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
			.campo { display: grid; gap: 6px; }
			.campo label { font: 700 12px var(--mono); color: var(--apagado); }
			.campo input, .campo select { font: 500 15px var(--sans); color: var(--texto); background: var(--fundo); border: 1.5px solid var(--borda); border-radius: 10px; padding: 11px 12px; width: 100%; }
			.campo input:focus, .campo select:focus { outline: none; border-color: var(--amarelo); }
			.campo input.erro, .campo select.erro { border-color: var(--erro); }
			.campo small, .erro-geral { font: 500 12px var(--mono); color: var(--erro); min-height: 0; }
			.campo small:empty, .erro-geral:empty { display: none; }
			.enviar { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-top: 6px; }
			.enviar small { font: 500 12px var(--mono); color: var(--apagado); }

			.lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 18px; }
			.lista :global(.item) { display: grid; gap: 8px; }
			.lista :global(.item img) { width: 100%; aspect-ratio: 9 / 16; object-fit: cover; border-radius: 12px; border: 1.5px solid var(--borda); background: var(--painel); }
			.lista :global(.item strong) { font-size: 14.5px; line-height: 1.3; }
			.lista :global(.item .meta) { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; font: 500 11.5px var(--mono); color: var(--apagado); }
			.lista :global(.item .acoes) { display: flex; gap: 6px; }
			.lista :global(.item .acoes button) { flex: 1; font: 700 12px var(--mono); padding: 8px; border-radius: 9px; border: 1.5px solid var(--borda); background: var(--painel); color: var(--texto); cursor: pointer; }
			.lista :global(.item .acoes button:hover) { border-color: var(--apagado); }
			.lista :global(.item .acoes button.confirmar) { border-color: var(--erro); color: var(--erro); }
			.lista :global(.vazio) { font: 500 13px var(--mono); color: var(--apagado); }

			.numeros { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
			.numeros :global(form) { padding: 18px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
			.numeros :global(strong) { font-size: 16px; }
			.numeros :global(.linha-numero) { display: flex; gap: 8px; }
			.numeros :global(input) { flex: 1; width: 100%; font: 700 18px var(--mono); color: var(--texto); background: var(--fundo); border: 1.5px solid var(--borda); border-radius: 10px; padding: 9px 12px; min-width: 0; }
			.numeros :global(input:focus) { outline: none; border-color: var(--amarelo); }
			.numeros :global(small) { font: 500 12px var(--mono); color: var(--apagado); }

			@media (max-width: 760px) {
				.form-video { grid-template-columns: 1fr; }
				.capa-campo { max-width: 200px; }
				.linha { grid-template-columns: 1fr; }
				.lista { grid-template-columns: 1fr 1fr; }
			}
		</style>
	</body>
</html>
