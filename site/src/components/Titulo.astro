---
// Título de seção com as palavras subindo como as legendas dos vídeos.
// O trecho em `destaque` fica amarelo (uma palavra amarela por título).
interface Props { antes?: string; destaque?: string; depois?: string; tag?: 'h1' | 'h2' | 'p'; class?: string; id?: string }
const { antes = '', destaque = '', depois = '', tag: Tag = 'h2', class: classe, id } = Astro.props;
const partes = (texto: string) => texto.split(/\s+/).filter(Boolean);
---
<Tag class={classe} id={id} data-palavras aria-label={[antes, destaque, depois].filter(Boolean).join(' ')}>
	<span aria-hidden="true">
		{partes(antes).map((p) => <><span class="palavra"><span>{p}</span></span>{' '}</>)}
		{destaque && <em>{partes(destaque).map((p) => <><span class="palavra"><span>{p}</span></span>{' '}</>)}</em>}
		{partes(depois).map((p) => <><span class="palavra"><span>{p}</span></span>{' '}</>)}
	</span>
</Tag>
