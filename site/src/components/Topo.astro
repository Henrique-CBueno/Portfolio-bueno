---
const secoes = [
	['sobre', 'sobre'],
	['videos', 'vídeos'],
	['projetos', 'projetos'],
	['stacks', 'stacks'],
	['premiacoes', 'premiações'],
	['contato', 'contato'],
];
---
<header class="topo" data-topo>
	<a class="marca" href="#inicio"><b></b>bueno_dev</a>
	<nav aria-label="Seções">
		{secoes.map(([id, rotulo]) => <a href={`#${id}`} data-link-secao={id}>{rotulo}</a>)}
		<span class="marcador" aria-hidden="true" data-marcador></span>
	</nav>
</header>

<style>
	.topo { position: sticky; top: 0; z-index: 20; max-width: var(--largura); margin: 0 auto; padding: 18px var(--margem); display: flex; justify-content: space-between; align-items: center; transition: background .3s, border-color .3s, backdrop-filter .3s; border-bottom: 1.5px solid transparent; }
	.topo.rolou { background: color-mix(in srgb, var(--fundo) 86%, transparent); backdrop-filter: blur(10px); border-bottom-color: var(--borda); max-width: none; padding-inline: max(var(--margem), calc((100vw - var(--largura)) / 2 + var(--margem))); }
	.marca { font: 700 15px var(--mono); display: flex; align-items: center; gap: 10px; text-decoration: none; }
	.marca b { width: 10px; height: 10px; border-radius: 3px; background: var(--ok); box-shadow: 0 0 0 4px rgba(61, 220, 132, .16); }
	nav { display: flex; gap: 6px; position: relative; }
	nav a { position: relative; z-index: 1; font: 500 13px var(--mono); color: var(--apagado); text-decoration: none; padding: 8px 12px; border-radius: 8px; transition: color .2s; }
	nav a:hover, nav a.ativo { color: var(--texto); }
	.marcador { position: absolute; left: 0; top: 0; height: 100%; width: 0; border-radius: 8px; background: var(--painel); border: 1.5px solid var(--borda); opacity: 0; pointer-events: none; }
	@media (max-width: 960px) { nav { display: none; } }
</style>
