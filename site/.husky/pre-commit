# GitHub Flow: nada de commit direto na main. Trabalho vai numa branch (feat/…, fix/…) e volta por merge/PR.
# A exceção é o commit que fecha um merge com conflito resolvido.
if [ "$(git branch --show-current)" = "main" ] && [ ! -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
	echo "✖ commit direto na main não: crie uma branch (ex.: git switch -c feat/minha-mudanca) e integre por merge/PR." >&2
	exit 1
fi

# Antes de cada commit: lint e formatação nos arquivos do site que vão no commit (corrigidos e readicionados
# pelo lint-staged) e a checagem de tipos. Commit só da API ou dos docs não passa por aqui.
git diff --cached --name-only | grep -q '^site/' || exit 0

cd site || exit 1
# o Node do projeto (.nvmrc); o do sistema pode ser antigo demais
if [ -s "$HOME/.nvm/nvm.sh" ]; then . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 && nvm use --silent >/dev/null 2>&1; fi

npx lint-staged
npm run check
